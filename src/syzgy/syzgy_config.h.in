/*
 * GENERATED FILE -- DO NOT EDIT.
 *
 * Generated by ./configure from src/syzgy/syzgy_config.h.in. Run
 * `./autogen.sh && ./configure` (or just `./configure` in an existing tree);
 * there is NO manual post-step and nothing to regenerate after a git reset.
 */

#ifndef SYZGY_SYZGY_CONFIG_H
#define SYZGY_SYZGY_CONFIG_H

/*
 * SYZGY_HAVE_RANDOMX
 *
 *   1 -- the vendored RandomX library (git submodule src/randomx, pinned commit
 *        7607fb2faed24d5a679e139a9828d194bbc644a4) was present at configure time and
 *        librandomx.a is being built and linked into ravend.
 *   0 -- it was not (submodule not checked out, --without-randomx, or an unsupported
 *        host architecture).
 *
 * This is a COMPILE-TIME gate, not a runtime one: the consensus layer needs to know at
 * compile time whether the RandomX path exists, because FR-01 makes both proofs mandatory.
 * When this is 0 the SYZGY RandomX glue reports itself UNAVAILABLE and every RandomX
 * verification fails closed. It NEVER fails open, and there is deliberately no runtime
 * option that disables RandomX verification.
 */
#define SYZGY_HAVE_RANDOMX @SYZGY_HAVE_RANDOMX@

/*
 * SYZGY_RANDOMX_LITE_MODE
 *
 *   1 -- build/select RandomX VMs in "light" mode: only the ~256 MiB cache is resident
 *        and dataset items are computed on the fly (useful on memory-constrained nodes
 *        and CI).
 *   0 -- "full" mode: the whole ~2 GiB dataset is resident.
 *
 * Both modes produce BIT-IDENTICAL hashes. This is a speed/RAM trade-off only and is
 * therefore NOT consensus critical. Set with --enable-randomx-lite-mode. There is
 * intentionally no runtime toggle, so a node's mode cannot change its answers.
 */
#define SYZGY_RANDOMX_LITE_MODE @SYZGY_RANDOMX_LITE_MODE@

#endif // SYZGY_SYZGY_CONFIG_H
